---
import { Image } from 'astro:assets';
import { type ProjectInfo } from '@/types';

interface Props {
  item: ProjectInfo;
  grid?: boolean;
}
const { item, grid = false } = Astro.props

const mediaCount = item.media?.length ?? (item.image ? 1 : 0);
// In grid mode columns are narrow, so always stack media on top instead of beside the text.
const sideLayout = mediaCount === 1 && !grid;

const mediaCls = 'w-full object-cover rounded-lg';
---

{sideLayout ? (
  <!-- Single media: side-by-side layout -->
  <div class="flex flex-col md:flex-row gap-4 p-4">
    <div class="md:w-2/5 flex-shrink-0">
      {item.media && item.media[0].type === 'video' ? (
        <video autoplay loop muted playsinline preload="metadata" class={`${mediaCls} max-h-64`}>
          <source src={item.media[0].src} />
        </video>
      ) : item.media && item.media[0].type === 'image-url' ? (
        <img src={item.media[0].src} alt={item.title} class={`${mediaCls} max-h-64`} />
      ) : item.media ? (
        <Image src={item.media[0].src} alt={item.title} class={mediaCls} />
      ) : item.image && !item.dontOptimizeImage ? (
        <Image src={item.image} alt={item.title} class={mediaCls} />
      ) : item.image ? (
        <img src={item.image.src} height={item.image.height} width={item.image.width} alt={item.title} class={mediaCls} />
      ) : null}
    </div>
    <div class="md:w-3/5 rounded-lg text-base-content">
      {item.disabled && <div class="float-right opacity-50 select-none text-xl align-middle ml-2"><i class="fa-solid fa-link-slash text-sm"></i></div>}
      <h3 class={`text-2xl font-semibold ${item.info ? '' : 'mb-2'}`}>{item.title}</h3>
      {item.info && <p class='text-sm mb-3 italic text-gray-600'>{item.info}</p>}
      <p class='text-base mb-2'>{item.description}</p>
    </div>
  </div>
) : (
  <!-- Multiple media (or stacked grid card): media above text -->
  {(!item.media || item.media.length === 0) && item.image && (
    <div class='w-full p-4 pb-0'>
      {!item.dontOptimizeImage ? (
        <Image src={item.image} alt={item.title} class={mediaCls} />
      ) : (
        <img src={item.image.src} height={item.image.height} width={item.image.width} alt={item.title} class={mediaCls} />
      )}
    </div>
  )}
  {item.media && item.media.length > 0 && (
    <div class={`w-full p-4 pb-0 gap-3 grid ${mediaCount === 1 ? 'grid-cols-1' : mediaCount === 3 ? 'grid-cols-3' : 'grid-cols-2'}`}>
      {item.media.map(m => (
        m.type === 'video' ? (
          <video autoplay loop muted playsinline preload="metadata" class={`${mediaCls} max-h-64`}>
            <source src={m.src} />
          </video>
        ) : m.type === 'image-url' ? (
          <img src={m.src} alt={item.title} class={`${mediaCls} max-h-64`} />
        ) : m.optimize !== false ? (
          <Image src={m.src} alt={item.title} class={`${mediaCls} max-h-64`} />
        ) : (
          <img src={m.src.src} height={m.src.height} width={m.src.width} alt={item.title} class={`${mediaCls} max-h-64`} />
        )
      ))}
    </div>
  )}
  {item.extraMedia && item.extraMedia.length > 0 && (
    <div class={`w-full p-4 pb-0 gap-3 grid ${item.extraMedia.length === 1 ? 'grid-cols-1' : item.extraMedia.length === 3 ? 'grid-cols-3' : 'grid-cols-2'}`}>
      {item.extraMedia.map(m => (
        m.type === 'video' ? (
          <video autoplay loop muted playsinline preload="metadata" class={`${mediaCls} max-h-64`}>
            <source src={m.src} />
          </video>
        ) : m.type === 'image-url' ? (
          <img src={m.src} alt={item.title} class={`${mediaCls} max-h-64`} />
        ) : m.optimize !== false ? (
          <Image src={m.src} alt={item.title} class={`${mediaCls} max-h-64`} />
        ) : (
          <img src={m.src.src} height={m.src.height} width={m.src.width} alt={item.title} class={`${mediaCls} max-h-64`} />
        )
      ))}
    </div>
  )}
  <div class='p-6 rounded-lg text-base-content'>
    {item.disabled && <div class="float-right opacity-50 select-none text-xl align-middle ml-2"><i class="fa-solid fa-link-slash text-sm"></i></div>}
    <h3 class={`text-2xl font-semibold ${item.info ? '' : 'mb-2'}`}>{item.title}</h3>
    {item.info && <p class='text-sm mb-3 italic text-gray-600'>{item.info}</p>}
    <p class='text-base mb-2'>{item.description}</p>
  </div>
)}
